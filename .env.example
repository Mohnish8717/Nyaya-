HOST=127.0.0.1
PORT=8000

# Gnani Prisma and Timbre are the mandatory speech components.
GNANI_API_KEY_ID=
# v3.0 is required for language identification (`indic-auto`) and code-mixed
# speech. v2.5 is single-language per session and has no auto-detect, so it is
# only a fallback when a fixed language is chosen.
PRISMA_MODEL=prisma-v3.0
PRISMA_FORMAT=codemix
# Server VAD is the end-of-turn signal: 350 ms is conversational, 300 is IVR.
PRISMA_MIN_SILENCE_MS=350
PRISMA_VAD_THRESHOLD=0.55
TIMBRE_MODEL=timbre-v3.0
TIMBRE_DEFAULT_VOICE=Shivani
TIMBRE_SAMPLE_RATE=24000
# Prisma closes a stream after fifteen minutes. The proxy re-dials a little
# before that, at a frame boundary, so the seam is ours rather than the
# provider's mid-word cut. Must stay below 900.
STT_ROTATE_SECONDS=840

# OpenAI-compatible endpoint for a self-hosted Gnani Evon, vLLM/SGLang,
# or another operator-selected LLM. Example vLLM URL: http://127.0.0.1:8001/v1
LLM_BASE_URL=http://127.0.0.1:8001/v1
LLM_API_KEY=
LLM_MODEL=gnani/gnani-evon-v3.3-30B-A3B
LLM_TIMEOUT_SECONDS=12
# Generation budget: wall-clock ceiling for the whole answer call, retries
# included. A voice turn must degrade rather than wait on a slow provider.
LLM_GENERATE_BUDGET_SECONDS=18
# 1,200 cut complete answers mid-sentence. A consultation-style answer -- the
# rule, the closest decision quoted, how it applies, one question -- needs room
# for all of it; 3,200 bounds the turn without truncating it.
LLM_MAX_TOKENS=3200

# Structured output. `auto` asks for a JSON Schema where the call does not use
# tools, and falls back to json_object if the server rejects it; set
# json_object to skip the probe on a server without guided decoding.
LLM_STRUCTURED_MODE=auto

# Provider rate limit, in tokens per minute, for this model and account. The
# gateway keeps its own 60-second window and waits for room instead of
# collecting a 429; a 429 gets exactly one short retry and then the turn
# degrades visibly. 0 disables local throttling (the provider is then the only
# limit). Read it from the provider's dashboard -- it cannot be inferred from
# the model name.
LLM_TPM_BUDGET=0

# How much retrieved evidence reaches the prompt. A count, not a legal limit:
# a land matter may need a central Act, a State amendment, a notification and a
# judgment together. Per-item character caps are the real budget.
LLM_MAX_SOURCES=6
LLM_MAX_CASES=5

# Second, independent check on every cited claim: does the quoted passage
# actually state the claim? An exact substring proves the words came from the
# source; it does not prove the source says what the claim says.
#   auto = run whenever a model is configured (default)
#   on / off = force it
LLM_ENTAILMENT=auto
# Optional smaller model and a tight deadline, since this runs after the answer
# and a slow checker only delays the turn.
LLM_ENTAILMENT_MODEL=
LLM_ENTAILMENT_TIMEOUT_SECONDS=4

# Post-retrieval relevance check: does this judgment address the caller's
# question, or only share its words? One small call over the top candidates.
# It can only remove candidates, never add one, and an unavailable judge leaves
# the list untouched.
#   auto = run whenever a model is configured (default)
#   off  = skip it entirely
LLM_CASE_JUDGE=auto
LLM_CASE_JUDGE_MODEL=
LLM_CASE_JUDGE_TIMEOUT_SECONDS=2.5
LLM_CASE_JUDGE_MAX_TOKENS=320

# Optional human-review connector. It is called only after a user request
# and a separate explicit consent to share the displayed summary.
REVIEW_PROVIDER_URL=
REVIEW_PROVIDER_TOKEN=

# Admin source/rule reload operations are disabled unless set.
ADMIN_TOKEN=

# Embedded judgment corpus (passage-level, built by legal_pipeline/).
# Default path is legal_pipeline/out/corpus_embeddings.sqlite3; set this to use
# a copy elsewhere. A missing artifact means that store does not answer — the
# curated partitions still do — and /api/health shows it under
# `embedded_judgment_corpus`.
JUDGMENT_CORPUS_DB=
JUDGMENT_CORPUS_ENABLED=auto
# Cosine floor for a dense-only passage hit. Below it the passage is dropped
# rather than returned as a nearest neighbour that happens to exist. Measured on
# this artifact: genuine cross-script questions score 0.45-0.66, a Telugu wage
# question 0.34, gibberish 0.35.
JUDGMENT_CORPUS_MIN_DENSE=0.45
# The same floor for the local judgment index (title + headnote vectors).
# Genuine topical questions 0.50-0.70, unrelated prose 0.20-0.36. Default 0.40.
DENSE_MIN_SCORE=0.40
# Matched passages scored by BM25 before the top-k cutoff. Raising it costs
# latency on relaxed OR queries and changes nothing on strict ones.
JUDGMENT_CORPUS_SCORE_POOL=800
